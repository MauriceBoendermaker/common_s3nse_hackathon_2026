# Copy to .env in the repository root. Never put secrets in VITE_* variables.
# No credentials are needed for the explicitly synthetic demo.

# Optional: use a reliable Ethereum MAINNET RPC. The default is a public endpoint.
ETH_RPC_URL=https://ethereum.reth.rs/rpc

# Required for live wallet holdings. Obtain a key from Mobula and paste it locally.
MOBULA_API_KEY=
MOBULA_API_URL=https://api.mobula.io/api/1

# API listener; Vite proxies /api to port 3001 during development.
PORT=3001
HOST=127.0.0.1

# Local mode is forced to restricted if NODE_ENV=production or HOST is non-loopback.
FOOTPRINT_MODE=local
# Set the exact HTTPS browser origin before public hosting (no trailing slash).
APP_ORIGIN=
# Comma-separated consenting names and proposed wallets. Empty names disable live hosting.
LIVE_DEMO_NAMES=
PREVIEW_WALLETS=
# Process-wide work jobs, not exact provider credits. One replica only; see DEPLOYMENT.md.
MAX_PROVIDER_JOBS_PER_HOUR=30
MAX_PROVIDER_CONCURRENCY=2
MOBULA_ACTIVITY_ENABLED=true
# Explicit proxy IPs/CIDRs only. Empty means forwarded IPs are not trusted.
TRUSTED_PROXY_IPS=
